# Shared with .gitattributes: LF, and a final newline, because committed artifacts are compared byte for
# byte and an editor's default is not a good reason for a fixture to differ.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
# Two trailing spaces are a hard line break in Markdown. Trimming them silently rewrites shipped prose —
# and README.md and AGENT-INSTALL.md are read by agents auditing the package.
trim_trailing_whitespace = false

[*.{lockb}]
insert_final_newline = false
trim_trailing_whitespace = false
