{
  "name": "@patchstack/connect",
  "version": "0.2.10",
  "description": "Patchstack connector for JavaScript applications. Scans your lockfile and reports installed packages to Patchstack for vulnerability monitoring.",
  "keywords": [
    "patchstack",
    "security",
    "vulnerability",
    "cve",
    "npm-audit",
    "sca",
    "dependency-scanning"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "patchstack-connect": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && node scripts/copy-protect-templates.mjs",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:manifest": "bun scripts/test-manifest.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^3.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/patchstack/connect.git"
  },
  "homepage": "https://patchstack.com",
  "bugs": {
    "url": "https://github.com/patchstack/connect/issues"
  }
}
